# 应用配置
APP_NAME=Customer Service AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# 服务器配置
APP_HOST=0.0.0.0
APP_PORT=8000

# 通义千问（旧适配层）：可选；未配置只表示该能力不可用，不影响启动
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Chroma向量数据库配置
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=customer_service_knowledge

# PostgreSQL数据库配置
DATABASE_URL=postgresql://postgres:password@localhost:5432/customer_service

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/var/log/customer_service_ai.log

# 安全配置：development/testing 可留空（使用 dev-only 默认值并打警告）；
# staging/production 缺失则启动失败
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 大模型参数配置
DEFAULT_MODEL=qwen-plus
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TOP_P=0.9
