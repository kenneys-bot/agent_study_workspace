# 配置模板：复制为 .env 后填入真实值。.env 不进 Git（600 权限），不要把密钥写进代码/日志。
# 统一模型适配层：src/bank_assistant/core/model_gateway.py（ADR-0004）

# 生成主用 DeepSeek 官方（OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=<placeholder>
DEEPSEEK_MODEL=deepseek-chat

# 第三方中继：仅作对比与显式回退；回退必须记录 model_provider，不能静默换模型
LLM_BASE_URL=https://<your-provider>/v1
LLM_API_KEY=<placeholder>
LLM_MODEL_CHAT=

# 供应商选择：deepseek（默认）或 relay；回退留空即不回退
MODEL_PROVIDER=deepseek
MODEL_FALLBACK_PROVIDER=
# 运行模式：live 调用真实模型；replay 回放（版本页会明确标识）
MODEL_MODE=live

# 代码版本：容器/CI 没有 .git 时由构建注入；本地留空则读取 git HEAD
GIT_SHA=
GIT_BRANCH=

# 模型标识：必须与 .env 实际一致，并记录到每次运行的 manifest
LLM_MODEL_CHAT_FAST=
LLM_MODEL_EMBEDDING=

# embedding：本机 fastembed（不是云调用）；local 是历史别名，仍兼容
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 调用纪律
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS_CHAT=3000
MONTHLY_BUDGET_CNY=200

# 开发回放：只能显式注入（ModelGateway(replay_responses=...)），
# 结果与日志标记 mode=replay；没有隐式 mock，不会自动启用。

# 应用环境：development / testing / staging / production
APP_ENV=development

# 安全配置（T08）：仅在启用认证/签名的环境必填。
# development/testing 缺失时使用显式 dev-only 默认值并打警告；
# staging/production 缺失则启动失败，不会静默使用弱默认值。
SECRET_KEY=<placeholder>

# 旧 DashScope 适配层不是生成主链（ADR-0004 改为 DeepSeek 官方）：
# 凭据可选，未配置只代表该能力不可用，不影响应用启动。
# DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 数据库（ADR-0006）：唯一实例在 Ubuntu，Mac 只经 SSH 隧道访问。
# 使用前先 `make db-tunnel`；没有隧道时连接必然失败，禁止回退本机 PG/SQLite。
# 同一实例按用途分库（密码只写在本机 .env 与服务器 .env.pg，不进 Git）：
#   bank_assistant_dev           日常开发
#   bank_assistant_demo          make seed-demo（幂等写入，测试不得清空）
#   bank_assistant_test          make test-integration（每次重建 public schema）
#   bank_assistant_restore_check 备份恢复验证目标
DATABASE_URL=postgresql+psycopg://bank:<password>@127.0.0.1:15432/bank_assistant_dev
# 隧道本地端口（默认 15432，脚本可覆盖）
# DB_TUNNEL_PORT=15432

# 数据与产物根目录：默认落在仓库外
DATA_ROOT=.local-data
ARTIFACT_ROOT=.local-artifacts
# Ubuntu 服务器示例（仓库外，单一项目目录）：DATA_ROOT=~/workspace/bank-assistant/data、ARTIFACT_ROOT=~/workspace/bank-assistant/artifacts
