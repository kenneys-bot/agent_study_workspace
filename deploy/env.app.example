# 服务器运行配置模板（M7-01/T29；api 与 worker 共用，T41）。真正的文件在仓库外：
#   ~/workspace/bank-assistant/.env.app（chmod 600，不进 Git、不进镜像）
#
# 用法见 docs/ops/runbook.md「首次部署」。不要在这里填真实值；
# 本模板只随仓库提交占位符，任何提交中出现真实 key/密码都算泄漏。

APP_ENV=staging
SECRET_KEY=<openssl rand -hex 32 生成；staging/production 必填>

# 服务器本机回环（同一 host，无需 SSH 隧道）；库用演示库。
DATABASE_URL=postgresql+psycopg://bank:<password>@127.0.0.1:5432/bank_assistant_demo

# 模型与索引身份（版本页会展示；必须与活动索引清单一致）。
MODEL_MODE=live
MODEL_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=<deepseek key；不写入仓库/日志>
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# T37 检索开关（默认值与评测采用配置一致；改 EMBEDDING_TEXT 必须重建索引）
RETRIEVAL_EMBEDDING_TEXT=title_chunk
RETRIEVAL_RERANK_ALPHA=0.2
RETRIEVAL_RERANK_POOL=20
DEMO_SCOPE_ID=demo-bank

# 日志只到 stdout，由 docker json-file 驱动轮转；不写原始会话正文。
LOG_LEVEL=INFO
