    {
      "id": "rule-cmp-01",
      "rule_code": "DEMO-CMP-01",
      "title": "不得阻碍客户投诉",
      "category": "complaint_obstruction",
      "description": "虚构演示制度：演示质检规则，识别坐席劝阻、拒绝或推诿客户投诉的行为，不对应任何真实机构规则。",
      "demo_only": true,
      "business_type": "complaint",
      "version_no": 1,
      "severity": "high",
      "valid_from": "2025-01-01T00:00:00+00:00",
      "valid_to": null,
      "applicability": {
        "business_types": [
          "complaint"
        ],
        "channels": [
          "phone",
          "online_chat"
        ],
        "conditions": [
          "客户明确表达投诉意愿或询问投诉渠道"
        ]
      },
      "criteria": {
        "evidence_requirements": [
          "定位客户表达投诉的原文轮次",
          "定位坐席劝阻、拒绝登记或推诿投诉的原文轮次"
        ],
        "decision_rules": [
          "坐席正常告知投诉渠道与处理时限不命中",
          "客户只是表达不满但未提出投诉时按不适用处理",
          "转述他人说法不能按关键词直接判定"
        ]
      },
      "exceptions": [
        "坐席按流程登记投诉并告知后续联系安排",
        "客户询问投诉渠道，坐席完整说明且未劝阻"
      ],
      "source_refs": [
        {
          "kind": "demo_policy",
