    {
      "id": "rule-att-01",
      "rule_code": "DEMO-ATT-01",
      "title": "不得使用明显侮辱性表达",
      "category": "insulting_language",
      "description": "虚构演示制度：演示质检规则，识别坐席对客户使用明显侮辱、贬损表达的行为，不对应任何真实机构规则。",
      "demo_only": true,
      "business_type": "complaint",
      "version_no": 1,
      "severity": "high",
      "valid_from": "2025-01-01T00:00:00+00:00",
      "valid_to": null,
      "applicability": {
        "business_types": [
          "complaint"
        ],
        "channels": [
          "phone",
          "online_chat"
        ],
        "conditions": [
          "坐席与客户发生争执或重复解释同一问题"
        ]
      },
      "criteria": {
        "evidence_requirements": [
          "定位坐席使用侮辱、贬损表达的原文轮次",
          "确认表达指向客户本人且不属于引用或转述"
        ],
        "decision_rules": [
          "坐席复述客户原话或引用规则文本时不能按关键词直接判定",
          "客户辱骂坐席不适用本规则；本规则只评判坐席表达",
          "语气助词或口头语不构成明显侮辱"
        ]
      },
      "exceptions": [
        "坐席引用客户原话进行核实，并明确说明是转述",
        "坐席使用中性表达重复解释，即使客户情绪激动"
      ],
      "source_refs": [
        {
          "kind": "demo_policy",
