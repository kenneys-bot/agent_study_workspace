  "entries": [
    {
      "id": "rule-fee-01",
      "rule_code": "DEMO-FEE-01",
      "title": "不得无依据承诺减免费用",
      "category": "unverified_fee_waiver",
      "description": "虚构演示制度：演示质检规则，识别坐席在未核验审批与条款依据时直接承诺减免年费、利息或违约金，不对应任何真实机构规则。",
      "demo_only": true,
      "business_type": "credit_card_fee",
      "version_no": 1,
      "severity": "high",
      "valid_from": "2025-01-01T00:00:00+00:00",
      "valid_to": null,
      "applicability": {
        "business_types": [
          "credit_card_fee"
        ],
        "channels": [
          "phone",
          "online_chat"
        ],
        "conditions": [
          "客户询问年费、利息或违约金能否减免"
        ]
      },
      "criteria": {
        "evidence_requirements": [
          "定位坐席承诺减免费用的原文轮次",
          "确认会话中没有审批结果、有效条款或减免政策依据"
        ],
        "decision_rules": [
          "仅说明“可提交减免申请/需审批”不算承诺减免，不命中",
          "客户转述或坐席引述他人说法时不能按关键词直接判定",
          "否定表述如“不能直接免”不命中"
        ]
      },
      "exceptions": [
        "坐席说明减免需审批并已提交申请，未承诺结果",
        "坐席引用有效减免政策并说明适用条件后再答复"
      ],
      "source_refs": [
        {
          "kind": "demo_policy",
          "ref": "https://demo.invalid/bank-assistant/credit-card-fee/demo-01",
          "note": "虚构演示制度：年费与费用减免审批要求"
        },
        {
          "kind": "public_regulation",
          "ref": "https://www.gov.cn/gongbao/content/2011/content_1893974.htm",
          "note": "公开监管要点摘要：信用卡费用披露与合同约定（自行组织，不复制原文）"
        },
        {
          "kind": "demo_rule_set",
          "ref": "https://demo.invalid/bank-assistant/rules/demo-rule-set-v1",
          "note": "演示质检规则集 v1（非真实银行规则）"
        }
      ],
