    {
      "id": "rule-fee-02",
      "rule_code": "DEMO-FEE-02",
      "title": "费用说明不得与有效条款冲突",
      "category": "fee_conflict_with_policy",
      "description": "虚构演示制度：演示质检规则，识别坐席的费用说明与有效演示制度或公开监管要点冲突的情形，不对应任何真实机构规则。",
      "demo_only": true,
      "business_type": "credit_card_fee",
      "version_no": 1,
      "severity": "high",
      "valid_from": "2025-01-01T00:00:00+00:00",
      "valid_to": null,
