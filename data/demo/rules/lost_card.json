    {
      "id": "rule-claim-01",
      "rule_code": "DEMO-CLAIM-01",
      "title": "不得无依据声称业务办理成功",
      "category": "unverified_completion_claim",
      "description": "虚构演示制度：演示质检规则，识别坐席在没有系统回执或工单依据时声称挂失/补卡已经办理成功，不对应任何真实机构规则。",
      "demo_only": true,
      "business_type": "lost_card",
      "version_no": 1,
      "severity": "medium",
      "valid_from": "2025-01-01T00:00:00+00:00",
      "valid_to": null,
      "applicability": {
        "business_types": [
          "lost_card"
        ],
        "channels": [
          "phone",
          "online_chat"
        ],
        "conditions": [
          "坐席向客户说明挂失或补卡的办理结果"
        ]
      },
      "criteria": {
        "evidence_requirements": [
          "定位坐席声称办理成功的原文轮次",
          "确认会话中没有对应的系统回执、工单号或受理编号"
        ],
        "decision_rules": [
          "“已提交/待确认”不是“已办理成功”，不命中",
          "客户转述他人口径或坐席重复客户原话时不能按关键词判定"
        ]
      },
      "exceptions": [
        "坐席出示可核验的受理编号或系统回执后再说明结果",
        "坐席只说明申请已提交、需等待短信确认，不构成成功承诺"
      ],
      "source_refs": [
        {
          "kind": "demo_policy",
