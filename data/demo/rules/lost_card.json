  "entries": [
    {
      "id": "rule-pwd-01",
      "rule_code": "DEMO-PWD-01",
      "title": "不得向客户索取密码或短信验证码",
      "category": "password_or_code_request",
      "description": "虚构演示制度：演示质检规则，识别坐席主动索取银行卡密码、支付密码或短信验证码的行为，不对应任何真实机构规则。",
      "demo_only": true,
      "business_type": "lost_card",
      "version_no": 1,
      "severity": "high",
      "valid_from": "2025-01-01T00:00:00+00:00",
      "valid_to": null,
      "applicability": {
        "business_types": [
          "lost_card"
        ],
        "channels": [
          "phone",
          "online_chat"
        ],
        "conditions": [
          "坐席引导客户核验身份或补办挂失"
        ]
      },
      "criteria": {
        "evidence_requirements": [
          "定位坐席索取密码或短信验证码的原文轮次",
          "确认客户未主动提供密码或验证码"
        ],
        "decision_rules": [
          "仅当坐席主动索取时命中；客户主动报出完整密码时转信息泄露处置",
          "否定与转述不能按关键词命中，例如“不会向您索要验证码”",
          "坐席提示客户在官方渠道自行输入且不收集验证码时按反例处理"
        ]
      },
      "exceptions": [
        "坐席只要求客户在官方 App 内自行输入密码，不要求告知",
        "客户主动报出密码时按安全事件处置流程处理，不适用本规则"
      ],
      "source_refs": [
        {
          "kind": "demo_policy",
          "ref": "https://demo.invalid/bank-assistant/lost-card/demo-01",
          "note": "虚构演示制度：挂失受理中的身份核验要求"
        },
        {
          "kind": "demo_rule_set",
          "ref": "https://demo.invalid/bank-assistant/rules/demo-rule-set-v1",
          "note": "演示质检规则集 v1（非真实银行规则）"
        }
      ],
      "examples": {
